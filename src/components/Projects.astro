---
import ProjectGrid from "@components/ProjectGrid.astro";
import type {ProjectItem} from "@components/ProjectGrid.astro";

const language = Astro.currentLocale;

let sectionTitle;
let projects: ProjectItem[];

switch (language) {
    case 'pl':
        sectionTitle = 'Nasze projekty';
        projects = [
            {
                title: "The Makers",
                description: "Realizacja grantu w ramach programu Horyzont Europa",
                logo: "/assets/projects/the-makers.png",
                url: "https://themakers.us.edu.pl/",
                badge: null
            },
            {
                title: "Odzież Robocza",
                description: "Ubrania robocze nowej generacji",
                logo: "/assets/projects/or.svg",
                url: "https://odziez.robocza.org",
                badge: null
            },
            {
                title: "Eden Learning Garden",
                description: "Seria wydarzeń i interdyscyplinarnych seminariów",
                logo: "/assets/projects/eden.svg",
                url: "https://eden.mvu.pl",
                badge: null
            },
            {
                title: "Minimum Viable Utopia",
                description: "Społeczność skupiona wokół wyzwań współczesności i eksperymentów",
                logo: "/assets/projects/mvu.svg",
                url: "https://mvu.pl",
                badge: null
            },
            {
                title: "Wyprawa Robocza",
                description: "Wycieczki dla projektujących i\u00A0nie\u00A0tylko",
                logo: "/assets/projects/wyprawa-robocza.svg",
                url: "https://wyprawa.robocza.org",
                badge: null
            },
            {
                title: "Agrocybernetyka",
                description: "Ogrodnictwo 2.0 i Parcelowy Ogród Społeczny Pod Gwiazdami",
                logo: "/assets/projects/agrocybernetyka.svg",
                url: "https://agrocybernetyka.pl/",
                badge: null
            },
        ];
        break;
    case 'en':
        sectionTitle = 'Our projects';
        projects = [
            {
                title: "The Makers",
                description: "A grant project under the Horizon Europe programme",
                logo: "/assets/projects/the-makers.png",
                url: "https://themakers.us.edu.pl/",
                badge: null
            },
            {
                title: "Odzież Robocza",
                description: "Next-generation workwear",
                logo: "/assets/projects/or.svg",
                url: "https://odziez.robocza.org",
                badge: null
            },
            {
                title: "Eden Learning Garden",
                description: "A series of events and interdisciplinary seminars",
                logo: "/assets/projects/eden.svg",
                url: "https://eden.mvu.pl",
                badge: null
            },
            {
                title: "Minimum Viable Utopia",
                description: "A community focused on contemporary challenges and experiments",
                logo: "/assets/projects/mvu.svg",
                url: "https://mvu.pl",
                badge: null
            },
            {
                title: "Wyprawa Robocza",
                description: "Trips for designers and everyone else",
                logo: "/assets/projects/wyprawa-robocza.svg",
                url: "https://wyprawa.robocza.org",
                badge: null
            },
            {
                title: "Agrocybernetyka",
                description: "Gardening 2.0 and the Pod Gwiazdami Community Allotment Garden",
                logo: "/assets/projects/agrocybernetyka.svg",
                url: "https://agrocybernetyka.pl/",
                badge: null
            },
        ];
        break;
}
---
<ProjectGrid title={sectionTitle} items={projects} />
