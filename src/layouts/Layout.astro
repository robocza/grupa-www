---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";

export interface Props {
  title: string;
  // Shown in search results and link previews.
  description?: string;
  // Link preview image: a path on this site to a 1200 × 630 image from src/pages/og/.
  image?: string;
  imageAlt?: string;
  // Blog posts: shared as articles, with their publication date.
  publishedTime?: Date;
}

const language = Astro.currentLocale;
const { title } = Astro.props;
const makeTitle = title ? title + " | " + "Grupa Robocza" : "Grupa Robocza";

const siteName = "Grupa Robocza";
const defaultDescriptions: Record<string, string> = {
  pl: "Grupa Robocza to interdyscyplinarny zespół ekspercki. Zajmujemy się doradztwem i badaniami w obszarze szeroko pojętego projektowania oraz nowych technologii.",
  en: "Working Group is an interdisciplinary team of experts. We provide consulting and research services in the broadly understood area of design and new technologies.",
};
const openGraphLocales: Record<string, string> = { pl: "pl_PL", en: "en_GB" };
const description = Astro.props.description || defaultDescriptions[language ?? "pl"];
// Link previews need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(Astro.props.image ?? "/og/grupa-robocza.jpg", Astro.site);
const imageAlt = Astro.props.imageAlt ?? siteName;
const imageType = imageUrl.pathname.endsWith(".png") ? "image/png" : "image/jpeg";
const { publishedTime } = Astro.props;
---

<!DOCTYPE html>
<html lang={language} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{makeTitle}</title>
    <meta name="description" content={description} />
    <!-- Link previews (Open Graph, also read by X/Twitter) -->
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={openGraphLocales[language ?? "pl"]} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={makeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:global>
      @font-face {
        font-family: 'GT America Regular';
        src: url('/fonts/GT-America-Standard-Regular.woff2') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }

      ul {
        list-style: disc inside;
      }
    </style>
  </body>
</html>
