---
import { Image } from 'astro:assets';
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import SectionHeader from "@components/SectionHeader.astro";
import CartLink from "@components/CartLink.astro";
import { getActiveProducts, isAvailable, lowestPrice, hasPriceRange, formatPrice } from "@lib/shop";

const products = await getActiveProducts();
const locale = Astro.currentLocale;
---
<Layout title="Sklep">
    <Container>
        <div class="mt-10 flex justify-end">
            <CartLink />
        </div>
        <div class="mt-2">
            <SectionHeader>
                <Fragment slot="title">Sklep</Fragment>
            </SectionHeader>
        </div>
        {products.length === 0 && (
            <p class="text-2xl mt-6">Sklep jest chwilowo pusty. Zajrzyj wkrótce!</p>
        )}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 sm:gap-4 xl:gap-6 mt-6 md:mt-12">
            {
                products.map(product => {
                    const [cover] = product.data.images;
                    const available = isAvailable(product);

                    return (
                        <a href={`/sklep/${product.slug}`} class="group mb-6 md:mb-12">
                            <div class="relative">
                                <Image class:list={["border-2 border-black aspect-square object-cover w-full", {"opacity-50": !available}]} src={cover.src} alt={cover.alt} width="600" optimize />
                                {!available && (
                                    <span class="absolute left-0 top-0 m-3 bg-black text-white uppercase px-2 py-1">Wyprzedane</span>
                                )}
                            </div>
                            <h2 class="my-1 text-2xl md:text-3xl leading-normal group-hover:underline">
                                {product.data.name}
                            </h2>
                            <p class="text-xl uppercase leading-normal">
                                {hasPriceRange(product) && "od "}{formatPrice(lowestPrice(product), locale)}
                            </p>
                            {product.data.summary && (
                                <p class="text-lg leading-normal">{product.data.summary}</p>
                            )}
                        </a>
                    );
                })
            }
        </div>
    </Container>
</Layout>
